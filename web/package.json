{
  "name": "heritg",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "context": "node scripts/heritg-context.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint .",
    "vercel:configure": "node scripts/render-vercel-config.mjs",
    "vercel:configure:staging": "node scripts/render-vercel-config.mjs --staging",
    "release:check": "node ../.agents/skills/release-heritg-web/scripts/release-preflight.mjs --ci",
    "release:verify": "node ../.agents/skills/release-heritg-web/scripts/verify-production.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "rollback:production": "node scripts/rollback-production.mjs",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "dns:staging": "node scripts/configure-staging-dns.mjs",
    "dns:staging:remove-beta": "node scripts/configure-staging-dns.mjs --remove-beta"
  },
  "dependencies": {
    "@daypicker/react": "10.0.1",
    "@excalidraw/excalidraw": "0.18.1",
    "idb": "8.0.3",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rork-plist": "0.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.20.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "17.11.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.2.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.8"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.0.9"
    }
  }
}
